# https://docs.github.com/en/get-started/git-basics/ignoring-files
# Baseado no padrão do Angular CLI + Node.js (recomendado para SPAs Angular)

# --- Build e cache do Angular ---
/dist
/tmp
/out-tsc
/bazel-out
/.angular/cache

# --- Dependências ---
/node_modules

# --- Variáveis de ambiente e segredos (não versionar) ---
.env
.env.*
!.env.example

# --- Logs de package managers ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Testes (Karma / Jasmine) ---
/coverage
*.lcov
/libpeerconnection.log
testem.log
/connect.lock

# --- Lint / formatação (cache local) ---
.eslintcache
.prettier-cache

# --- IDEs e editores ---
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project

# Visual Studio Code (mantém snippets de time versionados, se quiser)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/

# Visual Studio
.vs/

# --- Sass / assets gerados ---
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/
/typings

# --- Sistema operacional ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
